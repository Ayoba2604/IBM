# Application
APP_NAME=SIG-Banca
APP_INSTITUTION=Fatec Bauru
APP_TIMEZONE=America/Sao_Paulo
APP_DEBUG=false

# Base URL is auto-detected from the request. Set only when the application
# sits behind a proxy or a different public address.
# APP_URL=https://sig-banca.exemplo.br

# Database (defaults match a standard XAMPP installation)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sig_banca
DB_USERNAME=root
DB_PASSWORD=

# Uploads (bytes) and development mail transport
UPLOAD_MAX_BYTES=10485760
SMTP_ENABLED=false
