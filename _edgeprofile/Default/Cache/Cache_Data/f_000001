/* ==========================================================================
   SIG-Banca · Design system
   Fatec Bauru — academic navy, warm gold and calm off-white surfaces.
   ========================================================================== */

:root {
    --navy-950: #061429;
    --navy-900: #0b1f3a;
    --navy-800: #12325c;
    --navy-700: #1a4173;
    --blue-700: #1d4ed8;
    --blue-600: #2563eb;
    --blue-500: #3b82f6;
    --blue-100: #dbeafe;
    --blue-50: #eff6ff;
    --gold-600: #b9832a;
    --gold-500: #d9a441;
    --gold-100: #faeccd;
    --ink: #101828;
    --ink-soft: #344054;
    --muted: #667085;
    --muted-soft: #98a2b3;
    --paper: #f4f6fb;
    --surface: #ffffff;
    --surface-2: #f8fafc;
    --line: #e4e7ec;
    --line-soft: #eef1f6;
    --green: #0e7a54;
    --green-soft: #dcf5e9;
    --amber: #b54708;
    --amber-soft: #fef0c7;
    --red: #b42318;
    --red-soft: #fee4e2;
    --radius-xs: 8px;
    --radius-sm: 10px;
    --radius: 14px;
    --radius-lg: 20px;
    --radius-xl: 28px;
    --shadow-xs: 0 1px 2px rgba(16, 24, 40, .05);
    --shadow-sm: 0 2px 8px rgba(16, 24, 40, .06);
    --shadow-md: 0 12px 28px -12px rgba(16, 24, 40, .18);
    --shadow-lg: 0 30px 60px -28px rgba(6, 20, 41, .45);
    --sidebar: 272px;
    --font: "DM Sans", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
    --display: "Fraunces", "Iowan Old Style", Georgia, serif;
}

*,
*::before,
*::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
    margin: 0;
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font: 15px/1.55 var(--font);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

body.app-body {
    background:
        radial-gradient(1100px 520px at 100% -10%, rgba(37, 99, 235, .07), transparent 60%),
        var(--paper);
}

img, svg { max-width: 100%; }
a { color: var(--blue-700); text-decoration: none; }
a:hover { color: var(--blue-600); }
h1, h2, h3, h4, p { margin-top: 0; }
h1, h2, h3, h4 { letter-spacing: -.02em; line-height: 1.2; }
h1 { font-size: 1.85rem; }
h2 { font-size: 1.28rem; }
h3 { font-size: 1.02rem; }
p { line-height: 1.65; }
button, input, select, textarea { font: inherit; }
code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .86em;
    background: rgba(16, 24, 40, .06);
    padding: .14em .4em;
    border-radius: 5px;
}
:focus-visible {
    outline: 3px solid rgba(37, 99, 235, .35);
    outline-offset: 2px;
    border-radius: 6px;
}

.sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0);
    white-space: nowrap; border: 0;
}

.skip-link {
    position: fixed;
    top: 10px; left: 10px;
    z-index: 999;
    padding: 10px 16px;
    border-radius: var(--radius-xs);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-md);
    transform: translateY(-160%);
    transition: transform .18s ease;
}
.skip-link:focus { transform: translateY(0); }

/* --------------------------------------------------------------------------
   Buttons, badges and pills
   -------------------------------------------------------------------------- */

.btn {
    --btn-bg: var(--blue-600);
    --btn-fg: #fff;
    --btn-border: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--btn-border);
    border-radius: var(--radius-xs);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-weight: 600;
    font-size: .92rem;
    line-height: 1.2;
    cursor: pointer;
    white-space: nowrap;
    transition: transform .16s ease, background .16s ease, box-shadow .16s ease, color .16s ease;
}
.btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); color: var(--btn-fg); }
.btn:active { transform: translateY(0); }
.btn i { font-size: 1rem; }

.btn.primary { --btn-bg: var(--blue-600); }
.btn.primary:hover { --btn-bg: var(--blue-700); }
.btn.secondary { --btn-bg: var(--ink); }
.btn.ghost {
    --btn-bg: transparent;
    --btn-fg: var(--ink-soft);
    --btn-border: var(--line);
}
.btn.ghost:hover { --btn-bg: var(--surface-2); --btn-fg: var(--ink); }
.btn.warning { --btn-bg: var(--amber-soft); --btn-fg: #7a3d05; }
.btn.warning:hover { --btn-bg: #fde9b0; }
.btn.danger { --btn-bg: var(--red-soft); --btn-fg: var(--red); }
.btn.success { --btn-bg: var(--green-soft); --btn-fg: var(--green); }
.btn.gold { --btn-bg: var(--gold-500); --btn-fg: var(--navy-950); }
.btn.gold:hover { --btn-bg: #e6b95d; }
.btn.ghost-on-dark {
    --btn-bg: rgba(255, 255, 255, .08);
    --btn-fg: #eaf2ff;
    --btn-border: rgba(255, 255, 255, .18);
}
.btn.ghost-on-dark:hover { --btn-bg: rgba(255, 255, 255, .15); }
.btn.ghost-dark {
    --btn-bg: rgba(255, 255, 255, .1);
    --btn-fg: #fff;
    --btn-border: rgba(255, 255, 255, .18);
}
.btn.ghost-dark:hover { --btn-bg: rgba(255, 255, 255, .18); }
.btn.small { padding: 7px 12px; font-size: .82rem; }
.btn.large { padding: 13px 22px; font-size: .98rem; border-radius: 11px; }
.btn.full { width: 100%; }

.icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px; height: 40px;
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--surface);
    color: var(--ink-soft);
    cursor: pointer;
    transition: background .16s ease, color .16s ease, border-color .16s ease;
}
.icon-btn:hover { background: var(--blue-50); color: var(--blue-700); border-color: var(--blue-100); }
.icon-btn i { font-size: 1.1rem; }

.icon-link {
    display: inline-grid;
    place-items: center;
    width: 34px; height: 34px;
    border-radius: 9px;
    background: var(--surface-2);
    color: var(--ink-soft);
    font-size: 1rem;
    transition: background .16s ease, color .16s ease;
}
.icon-link:hover { background: var(--blue-50); color: var(--blue-700); }

.badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border-radius: 999px;
    background: #eef1f6;
    color: var(--muted);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .01em;
    line-height: 1.4;
    white-space: nowrap;
}
.badge i { font-size: .8rem; }
.badge.success { background: var(--green-soft); color: var(--green); }
.badge.info { background: var(--blue-50); color: var(--blue-700); }
.badge.warning { background: var(--amber-soft); color: var(--amber); }
.badge.danger { background: var(--red-soft); color: var(--red); }
.badge.pending { background: #eef4ff; color: #3a5f9e; }
.badge.neutral { background: #f1f3f7; color: var(--muted); }

.count-pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: .76rem;
    font-weight: 700;
}
.count-pill.muted { background: var(--surface-2); color: var(--muted); }

.eyebrow {
    display: inline-block;
    color: var(--muted);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
}
.eyebrow.light { color: #a9c4ec; }

/* --------------------------------------------------------------------------
   Authenticated shell
   -------------------------------------------------------------------------- */

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    width: var(--sidebar);
    padding: 26px 18px 18px;
    background:
        radial-gradient(420px 260px at 10% 0%, rgba(37, 99, 235, .28), transparent 70%),
        radial-gradient(320px 240px at 100% 35%, rgba(217, 164, 65, .12), transparent 70%),
        linear-gradient(180deg, var(--navy-900), var(--navy-950));
    color: #c8d6ea;
    overflow-y: auto;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
}
.brand:hover { color: #fff; }
.brand-mark {
    display: grid;
    place-items: center;
    width: 42px; height: 42px;
    flex: 0 0 auto;
    border-radius: 12px;
    background: linear-gradient(145deg, var(--gold-500), #b9832a);
    color: var(--navy-950);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .04em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5), 0 6px 14px -6px rgba(217, 164, 65, .8);
}
.brand-text { display: grid; line-height: 1.2; }
.brand-text strong { font-size: 1.06rem; letter-spacing: -.02em; }
.brand-text small { color: #8ea6c5; font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; }

.side-nav { display: flex; flex-direction: column; gap: 3px; margin-top: 34px; }
.nav-label {
    margin: 22px 12px 8px;
    color: #6f89ac;
    font-size: .63rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
}
.nav-label:first-child { margin-top: 0; }
.nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 12px;
    border-radius: 10px;
    color: #b5c6dd;
    font-size: .9rem;
    font-weight: 500;
    transition: background .16s ease, color .16s ease;
}
.nav-link i { width: 18px; font-size: 1.02rem; color: #7f9abc; text-align: center; }
.nav-link:hover { background: rgba(255, 255, 255, .07); color: #fff; }
.nav-link:hover i { color: #d9e6f8; }
.nav-link.active {
    background: linear-gradient(90deg, rgba(37, 99, 235, .32), rgba(37, 99, 235, .08));
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(120, 165, 235, .18);
}
.nav-link.active::before {
    content: "";
    position: absolute;
    left: -18px;
    top: 9px; bottom: 9px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--gold-500);
}
.nav-link.active i { color: #f0c371; }

.sidebar-foot { margin-top: auto; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, .09); }
.user-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 11px;
    color: #e8f0fb;
    background: rgba(255, 255, 255, .05);
}
.user-chip:hover { background: rgba(255, 255, 255, .09); color: #fff; }
.user-chip-text { display: grid; min-width: 0; line-height: 1.25; }
.user-chip-text strong { font-size: .82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-chip-text small { color: #8ea6c5; font-size: .7rem; }
.logout-form { margin-top: 10px; }
.logout {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 9px 10px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: #9fb4d1;
    font-size: .84rem;
    cursor: pointer;
    text-align: left;
}
.logout:hover { background: rgba(255, 255, 255, .06); color: #fff; }

.avatar {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: linear-gradient(145deg, #dbeafe, #bfdbfe);
    color: var(--blue-700);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .02em;
}
.avatar.small { width: 34px; height: 34px; font-size: .72rem; }
.avatar.tiny { width: 26px; height: 26px; font-size: .62rem; }

.sidebar-scrim {
    position: fixed;
    inset: 0;
    z-index: 35;
    border: 0;
    background: rgba(6, 20, 41, .55);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
}

.app {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin-left: var(--sidebar);
}

.topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
    padding: 12px clamp(20px, 3.2vw, 44px);
    border-bottom: 1px solid var(--line-soft);
    background: rgba(244, 246, 251, .88);
    backdrop-filter: blur(12px);
}
.topbar-left { display: flex; align-items: center; gap: 14px; min-width: 0; }
.topbar-title { min-width: 0; }
.topbar-title h1 {
    margin: 1px 0 0;
    font-size: 1.32rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.topbar-actions { display: flex; align-items: center; gap: 12px; }
.menu-btn { display: none; }

.user-pill { display: flex; align-items: center; gap: 9px; padding-left: 12px; border-left: 1px solid var(--line); }
.user-pill > span:last-child { display: grid; line-height: 1.25; }
.user-pill strong { font-size: .82rem; max-width: 170px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-pill small { color: var(--muted); font-size: .7rem; }

.notif { position: relative; }
.notif summary { list-style: none; }
.notif summary::-webkit-details-marker { display: none; }
.notif-trigger { position: relative; }
.notif .dot {
    position: absolute;
    top: -5px; right: -5px;
    display: grid;
    place-items: center;
    min-width: 18px; height: 18px;
    padding: 0 4px;
    border: 2px solid var(--paper);
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: .62rem;
    font-weight: 700;
}
.notif-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 50;
    width: min(370px, calc(100vw - 32px));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
}
.notif-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    border-bottom: 1px solid var(--line-soft);
}
.notif-head strong { font-size: .88rem; }
.notif-head span { color: var(--muted); font-size: .72rem; }
.notif-panel ul { margin: 0; padding: 0; list-style: none; max-height: 330px; overflow-y: auto; }
.notif-panel li { border-bottom: 1px solid var(--line-soft); }
.notif-panel li:last-child { border-bottom: 0; }
.notif-panel li.unread { background: #f7faff; }
.notif-panel li a { display: grid; gap: 2px; padding: 12px 16px; color: var(--ink); }
.notif-panel li a:hover { background: var(--surface-2); }
.notif-panel li strong { font-size: .82rem; }
.notif-panel li span { color: var(--muted); font-size: .78rem; line-height: 1.45; }
.notif-panel li small { color: var(--muted-soft); font-size: .68rem; }
.notif-empty { margin: 0; padding: 20px 16px; color: var(--muted); font-size: .84rem; }
.notif-all {
    display: block;
    padding: 11px 16px;
    border-top: 1px solid var(--line-soft);
    background: var(--surface-2);
    font-size: .78rem;
    font-weight: 700;
    text-align: center;
}

.content {
    flex: 1;
    width: 100%;
    max-width: 1340px;
    margin: 0 auto;
    padding: 28px clamp(20px, 3.2vw, 44px) 44px;
}
.app-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1340px;
    width: 100%;
    margin: 0 auto;
    padding: 18px clamp(20px, 3.2vw, 44px) 26px;
    color: var(--muted-soft);
    font-size: .74rem;
}
.app-footer-links { display: flex; gap: 16px; }
.app-footer-links a { color: var(--muted); }

/* --------------------------------------------------------------------------
   Page primitives
   -------------------------------------------------------------------------- */

.page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}
.page-head-text h2 { margin: 4px 0 4px; font-size: 1.55rem; }
.page-head-text p { margin: 0; color: var(--muted); max-width: 680px; }

.card {
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
}
.card + .card, .card + .grid-2, .grid-2 + .card, .card + .form, .form + .card { margin-top: 18px; }
.card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
}
.card-head.spaced { margin-top: 26px; }
.card-head h2 { margin: 3px 0 0; font-size: 1.05rem; }
.card-head p { margin: 2px 0 0; color: var(--muted); font-size: .84rem; }
.card-link { font-size: .8rem; font-weight: 700; white-space: nowrap; }
.card-link i { font-size: .78rem; }

.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: start; }
.dashboard-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
.grid-2 > *, .dashboard-grid > *, .metric-grid > * { min-width: 0; }
.dashboard-grid .span-2 { grid-column: span 2; }

.empty-state {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 34px 20px;
    color: var(--muted);
    text-align: center;
}
.empty-state i { font-size: 1.8rem; color: var(--muted-soft); }
.empty-state p { margin: 0; }
.empty-state.small { padding: 22px 12px; }
.empty-state.large { padding: 64px 20px; }
.empty-state.large h2 { margin: 6px 0; color: var(--ink); }
.empty-state .btn { margin-top: 8px; }

.muted { color: var(--muted); }
.small-note { font-size: .8rem; }
.dot-sep { color: var(--muted-soft); }
.span-2 { grid-column: span 2; }

/* --------------------------------------------------------------------------
   Alerts
   -------------------------------------------------------------------------- */

.alert {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: .87rem;
    line-height: 1.5;
}
.alert > i { margin-top: 2px; font-size: 1rem; }
.alert > span { flex: 1; }
.alert.success { background: #e8f7ef; border-color: #b7e6cf; color: #0d6849; }
.alert.error { background: var(--red-soft); border-color: #fecdca; color: #912018; }
.alert.warning { background: var(--amber-soft); border-color: #fedf89; color: #93370d; }
.alert.info { background: var(--blue-50); border-color: var(--blue-100); color: #1e40af; }
.alert-close {
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    opacity: .6;
}
.alert-close:hover { opacity: 1; }

/* --------------------------------------------------------------------------
   Dashboard
   -------------------------------------------------------------------------- */

.welcome-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);
    gap: 30px;
    overflow: hidden;
    padding: clamp(24px, 3.6vw, 40px);
    border-radius: var(--radius-lg);
    background:
        radial-gradient(520px 300px at 92% 0%, rgba(37, 99, 235, .38), transparent 65%),
        radial-gradient(340px 260px at 100% 100%, rgba(217, 164, 65, .2), transparent 60%),
        linear-gradient(140deg, var(--navy-900), var(--navy-950));
    color: #fff;
    box-shadow: var(--shadow-lg);
}
.welcome-card::after {
    content: "";
    position: absolute;
    right: -90px; top: -110px;
    width: 320px; height: 320px;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 50%;
}
.welcome-copy { position: relative; z-index: 1; }
.welcome-copy h2 { margin: 8px 0 8px; font: 700 clamp(1.7rem, 3vw, 2.5rem)/1.15 var(--display); }
.welcome-copy p { margin: 0; color: #c3d4ea; max-width: 590px; }
.welcome-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }

.next-banca {
    position: relative;
    z-index: 1;
    align-self: center;
    display: grid;
    gap: 10px;
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, .15);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, .07);
    backdrop-filter: blur(6px);
}
.next-label { color: #f0c371; font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.next-title { font-size: 1.05rem; line-height: 1.3; }
.next-meta { display: grid; gap: 5px; color: #c3d4ea; font-size: .8rem; }
.next-meta span { display: flex; align-items: center; gap: 7px; }
.next-meta i { color: #f0c371; }
.next-banca .btn { justify-self: start; margin-top: 4px; }
.empty-next p { margin: 0; color: #c3d4ea; font-size: .82rem; }

.metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
}
.metric-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
}
.metric-icon {
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    flex: 0 0 auto;
    border-radius: 12px;
    font-size: 1.15rem;
}
.metric-icon.blue { background: var(--blue-50); color: var(--blue-700); }
.metric-icon.gold { background: var(--gold-100); color: var(--gold-600); }
.metric-icon.green { background: var(--green-soft); color: var(--green); }
.metric-icon.slate { background: #eef1f6; color: #475467; }
.metric-card > div { display: grid; line-height: 1.2; }
.metric-value { font-size: 1.6rem; font-weight: 700; letter-spacing: -.03em; }
.metric-label { color: var(--muted); font-size: .76rem; margin-top: 2px; }

/* --------------------------------------------------------------------------
   Timeline and tables
   -------------------------------------------------------------------------- */

.timeline { display: grid; }
.event {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 10px;
    margin: 0 -10px;
    border-top: 1px solid var(--line-soft);
    border-radius: 10px;
    color: var(--ink);
    transition: background .15s ease;
}
.event:first-child { border-top: 0; }
.event:hover { background: var(--surface-2); color: var(--ink); }
.event-date {
    display: grid;
    place-items: center;
    width: 52px;
    flex: 0 0 auto;
    padding: 7px 0;
    border-radius: 10px;
    background: var(--blue-50);
    color: var(--blue-700);
    line-height: 1.1;
    text-align: center;
}
.event-date b { font-size: 1.15rem; font-weight: 700; }
.event-date small { font-size: .58rem; font-weight: 800; letter-spacing: .08em; }
.event-body { flex: 1; display: grid; gap: 2px; min-width: 0; }
.event-body strong { font-size: .9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
.event-body span { color: var(--muted); font-size: .78rem; }
.event-body small { color: var(--muted-soft); font-size: .72rem; }
.muted-timeline .event-date { background: var(--surface-2); color: var(--muted); }

.table-wrap { overflow-x: auto; max-width: 100%; -webkit-overflow-scrolling: touch; }
.table-wrap table { min-width: 460px; }
.table-wrap.compact table { min-width: 420px; }
table { width: 100%; border-collapse: collapse; }
th {
    padding: 0 12px 10px;
    color: var(--muted);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
}
td {
    padding: 13px 12px;
    border-top: 1px solid var(--line-soft);
    vertical-align: middle;
    font-size: .86rem;
}
tbody tr { transition: background .14s ease; }
tbody tr:hover { background: #fbfcfe; }
td small { display: block; margin-top: 2px; color: var(--muted); font-size: .72rem; }
td strong { font-weight: 600; }
td a { display: inline-flex; align-items: center; gap: 6px; }
.cell-action { width: 44px; text-align: right; white-space: nowrap; }

/* --------------------------------------------------------------------------
   Detail pages
   -------------------------------------------------------------------------- */

.detail-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
        radial-gradient(500px 240px at 100% 0%, rgba(37, 99, 235, .07), transparent 65%),
        var(--surface);
    box-shadow: var(--shadow-xs);
}
.detail-hero-main { min-width: 0; }
.detail-hero h2 { margin: 7px 0 10px; font-size: clamp(1.4rem, 2.4vw, 1.95rem); }
.detail-hero p { margin: 0 0 14px; color: var(--muted); max-width: 820px; }
.detail-eyebrow { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .8rem; }
.detail-flags { display: flex; flex-wrap: wrap; gap: 7px; }
.detail-hero-actions { display: flex; flex-wrap: wrap; gap: 9px; justify-content: flex-end; flex: 0 0 auto; }
.detail-hero-actions form { margin: 0; }

.meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
}
.meta-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
}
.meta-icon {
    display: grid;
    place-items: center;
    width: 38px; height: 38px;
    flex: 0 0 auto;
    border-radius: 10px;
    background: var(--blue-50);
    color: var(--blue-700);
}
.meta-card div { display: grid; line-height: 1.25; min-width: 0; }
.meta-card small { color: var(--muted); font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; }
.meta-card strong { font-size: .82rem; font-weight: 600; }

.card.stepper-card { margin-top: 18px; padding: 20px 22px; }
.stepper {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 6px 0 2px;
    list-style: none;
    overflow-x: auto;
}
.step {
    position: relative;
    display: flex;
    flex: 1 0 96px;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    text-align: center;
}
.step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 13px;
    left: calc(50% + 17px);
    right: calc(-50% + 17px);
    height: 2px;
    background: var(--line);
}
.step.done:not(:last-child)::after { background: #8fd7b8; }
.step-dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px; height: 28px;
    border: 2px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    font-size: .68rem;
    font-weight: 700;
}
.step.done .step-dot { border-color: #8fd7b8; background: #e8f7ef; color: var(--green); }
.step.current .step-dot {
    border-color: var(--blue-600);
    background: var(--blue-600);
    color: #fff;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, .14);
}
.step-label { color: var(--muted); font-size: .67rem; font-weight: 600; line-height: 1.25; max-width: 92px; }
.step.done .step-label { color: var(--ink-soft); }
.step.current .step-label { color: var(--blue-700); font-weight: 700; }

.info-list { display: grid; gap: 13px; margin: 0; }
.info-list > div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; align-items: start; }
.info-list dt { color: var(--muted); font-size: .76rem; font-weight: 600; }
.info-list dd { margin: 0; font-size: .86rem; }
.info-list dd:has(.people-list) { display: grid; gap: 6px; }
.people-list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
.people-list li { display: flex; align-items: center; gap: 8px; }
.people-list li > span:last-child { display: grid; line-height: 1.25; }
.people-list strong { font-size: .82rem; font-weight: 600; }
.people-list small { color: var(--muted); font-size: .7rem; }

.deadline {
    display: grid;
    gap: 10px;
    padding: 15px;
    border-radius: var(--radius-sm);
    background: var(--blue-50);
    color: #1e40af;
}
.deadline.overdue { background: #fff4f2; color: #912018; }
.deadline-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
.deadline-top b { font-size: 1rem; }
.deadline-top span { font-size: .76rem; font-weight: 600; }
.deadline p { margin: 0; color: var(--ink-soft); font-size: .82rem; }
.progress-track { height: 7px; border-radius: 99px; background: rgba(37, 99, 235, .14); overflow: hidden; }
.deadline.overdue .progress-track { background: rgba(180, 35, 24, .14); }
.progress-bar { display: block; width: var(--value, 50%); height: 100%; border-radius: inherit; background: currentColor; }

.deadline-list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
.deadline-list li a {
    display: grid;
    gap: 1px;
    padding: 9px 12px;
    border-left: 3px solid var(--blue-500);
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--ink);
}
.deadline-list li a:hover { background: var(--blue-50); color: var(--ink); }
.deadline-list li.late a { border-left-color: var(--red); background: #fff6f5; }
.deadline-list strong { font-size: .82rem; font-weight: 600; overflow-wrap: anywhere; }
.deadline-list span { color: var(--blue-700); font-size: .74rem; font-weight: 600; }
.deadline-list li.late span { color: var(--red); }
.deadline-list small { color: var(--muted); font-size: .7rem; }

.version-list { display: grid; }
.version {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 0;
    border-top: 1px solid var(--line-soft);
}
.version:first-child { border-top: 0; }
.version-tag {
    display: grid;
    place-items: center;
    width: 36px; height: 36px;
    flex: 0 0 auto;
    border-radius: 10px;
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: .74rem;
    font-weight: 800;
}
.version-body { flex: 1; display: grid; line-height: 1.3; min-width: 0; }
.version-body strong { font-size: .82rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
.version-body small { color: var(--muted); font-size: .7rem; }

.doc-type { font-size: .78rem; font-weight: 600; color: var(--ink-soft); }

.inline-menu { position: relative; display: inline-block; }
.inline-menu summary { list-style: none; }
.inline-menu summary::-webkit-details-marker { display: none; }
.inline-menu-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 20;
    display: grid;
    gap: 8px;
    width: 280px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow-md);
}
.inline-menu-panel textarea { min-height: 64px; }
.inline-menu-actions { display: flex; gap: 6px; justify-content: flex-end; }

.people-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.person-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
}
.person-body { flex: 1; display: grid; line-height: 1.3; min-width: 0; }
.person-body strong { font-size: .86rem; font-weight: 600; }
.person-body small { color: var(--muted); font-size: .72rem; overflow: hidden; text-overflow: ellipsis; }
.person-role { color: var(--blue-700); font-size: .68rem; font-weight: 700; margin-top: 3px; }
.person-side { display: grid; gap: 8px; justify-items: end; }
.person-side .btn { white-space: nowrap; }
.person-note { color: var(--muted); font-size: .68rem; }

/* --------------------------------------------------------------------------
   Forms
   -------------------------------------------------------------------------- */

.form { max-width: 980px; }
.form.compact { max-width: none; }
.form-section + .form-section { margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--line-soft); }
.form-section-head { margin-bottom: 16px; }
.form-section-head h3 { margin: 0 0 3px; font-size: 1.02rem; }
.form-section-head p { margin: 0; color: var(--muted); font-size: .82rem; }

.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px 16px; }
.field { display: grid; gap: 6px; min-width: 0; }
.field > span:first-child, .field-row .field > span:first-child {
    color: var(--ink-soft);
    font-size: .78rem;
    font-weight: 600;
}
.field small { color: var(--muted); font-size: .72rem; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

input, select, textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #d6dce6;
    border-radius: var(--radius-xs);
    background: var(--surface);
    color: var(--ink);
    font-size: .88rem;
    transition: border-color .15s ease, box-shadow .15s ease;
}
input::placeholder, textarea::placeholder { color: #a7b0bf; }
input:hover, select:hover, textarea:hover { border-color: #bcc5d3; }
input:focus, select:focus, textarea:focus {
    outline: 0;
    border-color: var(--blue-500);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .14);
}
textarea { resize: vertical; min-height: 80px; }
input[type="file"] { padding: 9px 10px; background: var(--surface-2); }
input[type="file"]::file-selector-button {
    margin-right: 10px;
    padding: 6px 10px;
    border: 0;
    border-radius: 6px;
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: .8rem;
    font-weight: 700;
    cursor: pointer;
}
input[type="checkbox"] { width: auto; accent-color: var(--blue-600); }

.form-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 9px; margin-top: 22px; }
.form-actions .btn.warning { margin-right: auto; }

fieldset { margin: 0; padding: 0; border: 0; }
.check-fieldset {
    max-height: 340px;
    overflow-y: auto;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
}
.check-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 7px; }
.check {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--surface);
    cursor: pointer;
    transition: border-color .15s ease, box-shadow .15s ease;
}
.check:hover { border-color: #bfd3f5; }
.check:has(input:checked) { border-color: var(--blue-500); box-shadow: 0 0 0 2px rgba(37, 99, 235, .1); }
.check input { flex: 0 0 auto; }
.check-body { display: grid; line-height: 1.3; min-width: 0; }
.check-body strong { font-size: .82rem; font-weight: 600; }
.check-body small { color: var(--muted); font-size: .7rem; overflow: hidden; text-overflow: ellipsis; }

.toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-bottom: 16px;
}
.toolbar-search {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 220px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--surface);
}
.toolbar-search i { color: var(--muted-soft); }
.toolbar-search input { padding: 10px 0; border: 0; box-shadow: none; background: transparent; }
.toolbar-search input:focus { box-shadow: none; }
.toolbar select { width: auto; min-width: 180px; }
.small-search { flex: 0 1 320px; margin-bottom: 10px; }
.small-search input { padding: 8px 0; }

.file-field { padding: 14px; border: 1px dashed #c8d3e4; border-radius: var(--radius-sm); background: var(--surface-2); }
.field-hidden { display: none !important; }

/* --------------------------------------------------------------------------
   Invitations and notifications
   -------------------------------------------------------------------------- */

.invite-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
.invite-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
}
.invite-card.status-aceito { border-color: #b7e6cf; }
.invite-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.invite-date { color: var(--muted); font-size: .74rem; display: flex; align-items: center; gap: 5px; }
.invite-card h3 { margin: 0; font-size: 1.02rem; line-height: 1.35; }
.invite-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; padding: 10px 0; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
.invite-meta div { display: grid; gap: 1px; }
.invite-meta dt { color: var(--muted); font-size: .64rem; text-transform: uppercase; letter-spacing: .06em; }
.invite-meta dd { margin: 0; font-size: .8rem; font-weight: 600; }
.invite-meta.wide { grid-template-columns: repeat(4, 1fr); gap: 14px; max-width: 640px; margin: 20px auto; text-align: left; }
.invite-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; }
.invite-state { display: inline-flex; align-items: center; gap: 5px; font-size: .74rem; font-weight: 600; }
.invite-state.pending { color: #3a5f9e; }
.invite-state.accepted { color: var(--green); }
.invite-state.refused { color: var(--amber); }
.invite-state.expired { color: var(--muted); }
.invite-actions { display: flex; gap: 7px; margin: 0; }
.invite-actions.center { justify-content: center; margin-top: 8px; }

.notification-list { margin: 0; padding: 0; list-style: none; }
.notification-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 15px 6px;
    border-top: 1px solid var(--line-soft);
}
.notification-list li:first-child { border-top: 0; }
.notification-list li.unread { background: linear-gradient(90deg, rgba(37, 99, 235, .045), transparent 70%); }
.notification-icon {
    display: grid;
    place-items: center;
    width: 38px; height: 38px;
    flex: 0 0 auto;
    border-radius: 10px;
    background: var(--blue-50);
    color: var(--blue-700);
}
.notification-icon.type-prazo { background: var(--amber-soft); color: var(--amber); }
.notification-icon.type-documento { background: var(--red-soft); color: var(--red); }
.notification-icon.type-banca { background: var(--green-soft); color: var(--green); }
.notification-body { flex: 1; }
.notification-body strong { display: flex; align-items: center; gap: 7px; font-size: .88rem; }
.notification-body p { margin: 2px 0 3px; color: var(--muted); font-size: .82rem; }
.notification-body small { color: var(--muted-soft); font-size: .7rem; }
.unread-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--blue-600); }

.audit-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
.audit-list li { display: flex; gap: 10px; padding: 10px 0; border-top: 1px solid var(--line-soft); }
.audit-list li:first-child { border-top: 0; }
.audit-dot { width: 8px; height: 8px; margin-top: 6px; flex: 0 0 auto; border-radius: 50%; background: var(--blue-500); box-shadow: 0 0 0 3px var(--blue-50); }
.audit-list div { display: grid; line-height: 1.35; }
.audit-list strong { font-size: .8rem; font-weight: 600; text-transform: capitalize; }
.audit-list small { color: var(--muted); font-size: .7rem; }

/* --------------------------------------------------------------------------
   Public site
   -------------------------------------------------------------------------- */

.public-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px clamp(20px, 6vw, 90px);
    border-bottom: 1px solid rgba(228, 231, 236, .8);
    background: rgba(255, 255, 255, .9);
    backdrop-filter: blur(12px);
}
.public-header .brand { color: var(--ink); }
.public-header .brand-text small { color: var(--muted); }
.public-nav { display: flex; align-items: center; gap: 22px; }
.public-nav > a { color: var(--ink-soft); font-size: .86rem; font-weight: 500; }
.public-nav > a:hover { color: var(--blue-700); }
.public-nav .btn { color: #fff; }
.public-main { overflow: hidden; }

.hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr);
    gap: clamp(34px, 5vw, 76px);
    align-items: center;
    padding: clamp(52px, 8vw, 100px) clamp(20px, 6vw, 90px);
    background:
        radial-gradient(700px 420px at 88% 10%, rgba(37, 99, 235, .4), transparent 65%),
        radial-gradient(520px 380px at 0% 100%, rgba(217, 164, 65, .16), transparent 60%),
        linear-gradient(135deg, var(--navy-900), var(--navy-950));
    color: #fff;
    overflow: hidden;
}
.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, .08) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: linear-gradient(90deg, transparent, rgba(0, 0, 0, .5));
    pointer-events: none;
}
.hero-copy { position: relative; z-index: 1; }
.hero h1 {
    margin: 12px 0 18px;
    font: 700 clamp(2.5rem, 5vw, 4.3rem)/1.03 var(--display);
    letter-spacing: -.035em;
}
.hero h1 em { color: var(--gold-500); font-style: normal; }
.hero-lead { max-width: 590px; color: #c3d4ea; font-size: 1.04rem; line-height: 1.7; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 11px; margin: 26px 0 22px; }
.hero-checks { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0; padding: 0; list-style: none; color: #a9c4ec; font-size: .78rem; }
.hero-checks li { display: flex; align-items: center; gap: 6px; }
.hero-checks i { color: var(--gold-500); }

.hero-panel {
    position: relative;
    z-index: 1;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, .06);
    backdrop-filter: blur(10px);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, .7);
}
.hero-panel-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, .12);
    color: #dbe7f8;
    font-size: .78rem;
    font-weight: 600;
}
.status-dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 4px rgba(74, 222, 128, .16); }
.hero-panel-tag { margin-left: auto; padding: 2px 8px; border-radius: 99px; background: rgba(74, 222, 128, .14); color: #86efac; font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
.hero-flow { display: grid; gap: 2px; margin: 10px 0 0; padding: 0; list-style: none; }
.hero-flow li { display: flex; gap: 13px; padding: 12px 8px; border-radius: 10px; }
.hero-flow li:hover { background: rgba(255, 255, 255, .05); }
.hero-flow li > span {
    display: grid;
    place-items: center;
    width: 30px; height: 30px;
    flex: 0 0 auto;
    border-radius: 9px;
    background: rgba(217, 164, 65, .16);
    color: #f0c371;
    font-size: .65rem;
    font-weight: 800;
}
.hero-flow div { display: grid; line-height: 1.3; }
.hero-flow strong { font-size: .86rem; color: #f2f7ff; }
.hero-flow small { color: #9fb6d3; font-size: .74rem; }
.hero-panel-foot { display: flex; align-items: center; justify-content: space-between; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, .12); color: #9fb6d3; font-size: .7rem; }
.hero-panel-foot code { background: rgba(255, 255, 255, .1); color: #dbe7f8; }

.public-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin: -38px auto 0;
    max-width: 1080px;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}
.public-stats > div {
    display: grid;
    gap: 2px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-md);
}
.public-stats > div:first-child { border-radius: var(--radius) 0 0 var(--radius); }
.public-stats > div:last-child { border-radius: 0 var(--radius) var(--radius) 0; }
.public-stats strong { font-size: 1.7rem; letter-spacing: -.03em; }
.public-stats span { color: var(--muted); font-size: .74rem; }

.feature-section { padding: clamp(60px, 8vw, 100px) clamp(20px, 6vw, 90px) 30px; }
.section-head { max-width: 680px; margin: 0 auto 34px; text-align: center; }
.section-head h2 { margin: 8px 0 10px; font: 700 clamp(1.7rem, 3.2vw, 2.5rem)/1.15 var(--display); }
.section-head p { margin: 0; color: var(--muted); }
.feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1160px; margin: 0 auto; }
.feature-card {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform .18s ease, box-shadow .18s ease;
}
.feature-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.feature-icon {
    display: grid;
    place-items: center;
    width: 42px; height: 42px;
    margin-bottom: 14px;
    border-radius: 11px;
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: 1.1rem;
}
.feature-card h3 { margin: 0 0 6px; font-size: .98rem; }
.feature-card p { margin: 0; color: var(--muted); font-size: .83rem; }

.cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin: 56px clamp(20px, 6vw, 90px) 80px;
    padding: clamp(28px, 4vw, 46px);
    border-radius: var(--radius-lg);
    background:
        radial-gradient(480px 260px at 88% 10%, rgba(217, 164, 65, .22), transparent 65%),
        linear-gradient(135deg, var(--navy-800), var(--navy-950));
    color: #fff;
}
.cta-band h2 { margin: 7px 0 6px; font: 700 clamp(1.5rem, 2.6vw, 2.05rem)/1.2 var(--display); }
.cta-band p { margin: 0; color: #c3d4ea; }

.public-footer {
    display: grid;
    grid-template-columns: 1.2fr auto;
    gap: 18px 40px;
    align-items: center;
    padding: 34px clamp(20px, 6vw, 90px);
    border-top: 1px solid var(--line);
    background: var(--surface);
}
.public-footer-brand { display: flex; align-items: center; gap: 12px; }
.public-footer-brand div { display: grid; line-height: 1.3; }
.public-footer-brand strong { font-size: .92rem; }
.public-footer-brand small { color: var(--muted); font-size: .74rem; }
.public-footer nav { display: flex; flex-wrap: wrap; gap: 18px; }
.public-footer nav a { color: var(--muted); font-size: .8rem; }
.public-footer-copy { grid-column: 1 / -1; color: var(--muted-soft); font-size: .72rem; }

/* --------------------------------------------------------------------------
   Auth
   -------------------------------------------------------------------------- */

body.auth-body {
    background:
        radial-gradient(800px 500px at 80% 0%, rgba(37, 99, 235, .25), transparent 65%),
        var(--navy-950);
}
.auth-shell { min-height: 100vh; }
.auth-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
    gap: clamp(30px, 6vw, 80px);
    align-items: center;
    min-height: 100vh;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 70px);
}
.auth-aside { color: #fff; display: flex; flex-direction: column; min-height: 520px; }
.auth-aside .brand { margin-bottom: 40px; }
.auth-copy { max-width: 520px; margin: auto 0; }
.auth-copy h1 { margin: 12px 0 16px; font: 700 clamp(2.1rem, 4vw, 3.4rem)/1.08 var(--display); letter-spacing: -.035em; }
.auth-copy p { color: #b8cbe4; max-width: 470px; }
.auth-list { display: grid; gap: 10px; margin: 24px 0 0; padding: 0; list-style: none; color: #cddcef; font-size: .88rem; }
.auth-list li { display: flex; align-items: center; gap: 9px; }
.auth-list i { color: var(--gold-500); }
.auth-footnote { margin: 40px 0 0; color: #7f95b3; font-size: .72rem; }

.auth-card {
    width: 100%;
    max-width: 460px;
    justify-self: center;
    display: grid;
    gap: 18px;
    padding: clamp(24px, 3.4vw, 38px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
}
.auth-card-head h2 { margin: 5px 0 4px; font-size: 1.55rem; }
.auth-card-head p { margin: 0; color: var(--muted); font-size: .86rem; }
.auth-form { display: grid; gap: 14px; }
.input-icon { position: relative; display: flex; align-items: center; }
.input-icon > i {
    position: absolute;
    left: 12px;
    color: var(--muted-soft);
    font-size: .95rem;
    pointer-events: none;
}
.input-icon input { padding-left: 36px; }
.input-icon input[type="password"], .input-icon input[data-password] { padding-right: 42px; }
.password-toggle {
    position: absolute;
    right: 5px;
    display: grid;
    place-items: center;
    width: 32px; height: 32px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
}
.password-toggle:hover { background: var(--surface-2); color: var(--ink); }

.demo-box {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    padding: 11px 13px;
}
.demo-box summary { color: var(--ink-soft); font-size: .8rem; font-weight: 600; cursor: pointer; }
.demo-box p { margin: 9px 0 6px; color: var(--muted); font-size: .74rem; }
.demo-box ul { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
.demo-box li { display: flex; justify-content: space-between; gap: 10px; font-size: .72rem; }
.demo-box li span { color: var(--muted); }
.demo-box code { font-size: .7rem; }
.auth-back { justify-self: center; color: var(--muted); font-size: .8rem; font-weight: 600; }
.auth-back i { font-size: .75rem; }

/* --------------------------------------------------------------------------
   Public search and result panels
   -------------------------------------------------------------------------- */

.search-hero {
    padding: clamp(46px, 7vw, 82px) clamp(20px, 6vw, 90px) 34px;
    background:
        radial-gradient(620px 380px at 80% 0%, rgba(37, 99, 235, .36), transparent 65%),
        linear-gradient(135deg, var(--navy-900), var(--navy-950));
    color: #fff;
    text-align: center;
}
.search-hero h2 { margin: 8px 0 8px; font: 700 clamp(2rem, 4vw, 3.1rem)/1.1 var(--display); }
.search-hero > p { color: #b8cbe4; }
.search-form {
    display: flex;
    gap: 9px;
    max-width: 820px;
    margin: 28px auto 12px;
}
.search-input { position: relative; display: flex; flex: 1; align-items: center; }
.search-input > i { position: absolute; left: 14px; color: #8396b1; }
.search-input input { padding: 13px 14px 13px 40px; border: 0; border-radius: var(--radius-xs); box-shadow: var(--shadow-sm); }
.search-form select { width: auto; min-width: 200px; border: 0; border-radius: var(--radius-xs); box-shadow: var(--shadow-sm); }
.search-summary { color: #9fb6d3; font-size: .78rem; }
.result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 16px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 28px clamp(20px, 6vw, 90px) 70px;
}
.result-card {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform .18s ease, box-shadow .18s ease;
}
.result-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.result-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.result-course { color: var(--muted); font-size: .7rem; }
.result-card h3 { margin: 2px 0 0; font-size: 1.02rem; line-height: 1.35; }
.result-card p { margin: 0; color: var(--muted); font-size: .82rem; flex: 1; }
.result-card footer { display: grid; gap: 4px; padding-top: 10px; border-top: 1px solid var(--line-soft); color: var(--muted); font-size: .74rem; }
.result-card footer span { display: flex; align-items: center; gap: 6px; }

.result-panel {
    display: grid;
    justify-items: center;
    max-width: 660px;
    margin: clamp(40px, 8vw, 90px) auto;
    padding: clamp(28px, 4vw, 46px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-align: center;
    box-shadow: var(--shadow-md);
}
.result-panel h2 { margin: 8px 0 8px; font-size: 1.6rem; }
.result-panel > p { color: var(--muted); max-width: 520px; }
.result-icon {
    display: grid;
    place-items: center;
    width: 62px; height: 62px;
    margin: 8px 0 4px;
    border-radius: 50%;
    font-size: 1.7rem;
}
.result-icon.success { background: var(--green-soft); color: var(--green); }
.result-icon.info { background: var(--blue-50); color: var(--blue-700); }
.result-icon.warning { background: var(--amber-soft); color: var(--amber); }
.result-actions { display: flex; gap: 9px; margin-top: 10px; }
.invite-result .invite-meta { width: 100%; }

/* --------------------------------------------------------------------------
   Calendar
   -------------------------------------------------------------------------- */

.calendar-nav { display: flex; align-items: center; gap: 7px; }
.calendar-card { padding: 20px; }
.calendar-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.calendar-head h2 { margin: 0; font-size: 1.12rem; }
.calendar-scroll { overflow-x: auto; }
.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(118px, 1fr));
    gap: 6px;
    min-width: 840px;
}
.calendar-weekday {
    padding: 6px 8px;
    color: var(--muted);
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
}
.calendar-day {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 106px;
    padding: 7px;
    border: 1px solid var(--line-soft);
    border-radius: 9px;
    background: var(--surface-2);
}
.calendar-day.outside { opacity: .45; }
.calendar-day.today { border-color: var(--blue-500); background: var(--blue-50); }
.calendar-day.has-events { background: var(--surface); }
.calendar-number { color: var(--muted); font-size: .7rem; font-weight: 700; }
.calendar-day.today .calendar-number { color: var(--blue-700); }
.calendar-event {
    display: grid;
    gap: 1px;
    padding: 4px 6px;
    border-left: 3px solid var(--blue-500);
    border-radius: 4px;
    background: #eef4ff;
    color: var(--ink);
    overflow: hidden;
}
.calendar-event:hover { background: #e0ebff; color: var(--ink); }
.calendar-event b { font-size: .6rem; color: var(--blue-700); }
.calendar-event span { font-size: .66rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.calendar-more { color: var(--muted); font-size: .62rem; font-weight: 600; }

/* --------------------------------------------------------------------------
   Errors
   -------------------------------------------------------------------------- */

.error-body {
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 24px;
    background:
        radial-gradient(800px 500px at 80% 0%, rgba(37, 99, 235, .28), transparent 65%),
        var(--navy-950);
}
.error-card {
    display: grid;
    justify-items: center;
    max-width: 520px;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-align: center;
    box-shadow: var(--shadow-lg);
}
.error-code { font: 700 3rem/1 var(--display); color: var(--gold-500); }
.error-card h1 { margin: 8px 0; font-size: 1.5rem; }
.error-card p { color: var(--muted); }

/* --------------------------------------------------------------------------
   Responsive
   -------------------------------------------------------------------------- */

@media (max-width: 1180px) {
    .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dashboard-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dashboard-grid .span-2 { grid-column: span 2; }
    .welcome-card { grid-template-columns: 1fr; }
    .next-banca { max-width: 460px; }
    .meta-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero { grid-template-columns: 1fr; }
    .hero-panel { max-width: 540px; }
    .public-stats { grid-template-columns: repeat(2, 1fr); }
    .public-stats > div:nth-child(2) { border-radius: 0 var(--radius) 0 0; }
    .public-stats > div:nth-child(1) { border-radius: var(--radius) 0 0 0; }
    .public-stats > div:nth-child(3) { border-radius: 0 0 0 var(--radius); }
    .public-stats > div:nth-child(4) { border-radius: 0 0 var(--radius) 0; }
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
    .auth-grid { grid-template-columns: 1fr; max-width: 520px; }
    .auth-aside { display: none; }
}

@media (max-width: 1024px) {
    .sidebar { transform: translateX(-100%); transition: transform .22s ease; box-shadow: var(--shadow-lg); }
    .sidebar.open { transform: translateX(0); }
    .sidebar-scrim.visible { opacity: 1; pointer-events: auto; }
    .app { margin-left: 0; }
    .menu-btn { display: inline-grid; }
    body.nav-open { overflow: hidden; }
}

@media (max-width: 840px) {
    .topbar { padding: 10px 18px; }
    .topbar-title h1 { font-size: 1.12rem; }
    .user-pill > span:last-child { display: none; }
    .user-pill { padding-left: 0; border-left: 0; }
    .content { padding: 22px 18px 36px; }
    .page-head { align-items: flex-start; flex-direction: column; }
    .grid-2, .form-grid, .check-grid { grid-template-columns: 1fr; }
    .span-2 { grid-column: span 1; }
    .detail-hero { flex-direction: column; }
    .detail-hero-actions { justify-content: flex-start; }
    .info-list > div { grid-template-columns: 1fr; gap: 3px; }
    .metric-grid { grid-template-columns: 1fr 1fr; }
    .dashboard-grid { grid-template-columns: 1fr; }
    .dashboard-grid .span-2 { grid-column: span 1; }
    .meta-grid { grid-template-columns: 1fr 1fr; }
    .search-hero { padding: 42px 18px 28px; }
    .search-form { flex-direction: column; }
    .search-form select { width: 100%; min-width: 0; }
    .result-grid { padding: 22px 18px 50px; }
    .feature-section { padding: 54px 18px 20px; }
    .feature-grid { grid-template-columns: 1fr; }
    .cta-band { flex-direction: column; align-items: flex-start; margin: 40px 18px 60px; }
    .public-footer { grid-template-columns: 1fr; padding: 28px 18px; }
    .public-header { padding: 12px 18px; }
    .public-nav { gap: 14px; }
    .public-nav > a:first-child { display: none; }
    .invite-meta.wide { grid-template-columns: 1fr 1fr; }
    .invite-grid { grid-template-columns: 1fr; }
    .card { padding: 17px; }
    .calendar-card { padding: 14px; }
    .welcome-card { padding: 22px; }
}

@media (max-width: 560px) {
    .topbar { min-height: 68px; }
    .topbar-title .eyebrow { display: none; }
    .topbar-title h1 { font-size: 1.02rem; }
    .metric-grid { grid-template-columns: 1fr 1fr; }
    .metric-card { flex-direction: column; align-items: flex-start; gap: 8px; padding: 14px; }
    .metric-card > div { gap: 1px; }
    .metric-value { font-size: 1.45rem; }
    .meta-grid { grid-template-columns: 1fr; }
    .event { gap: 10px; }
    .event-date { width: 46px; }
    .event .badge { display: none; }
    .public-stats { grid-template-columns: 1fr; margin-top: 0; padding: 0; }
    .public-stats > div, .public-stats > div:first-child, .public-stats > div:last-child { border-radius: 0; border-top: 0; }
    .hero { padding: 42px 18px 54px; }
    .hero h1 { font-size: 2.25rem; }
    .hero-actions .btn { width: 100%; }
    .auth-grid { padding: 18px; }
    .auth-card { padding: 22px 18px; }
    .invite-meta, .invite-meta.wide { grid-template-columns: 1fr; }
    .form-actions { flex-direction: column-reverse; }
    .form-actions .btn { width: 100%; }
    .form-actions .btn.warning { margin-right: 0; }
    .toolbar { align-items: stretch; }
    .toolbar select, .toolbar .btn { width: 100%; }
    .app-footer { flex-direction: column; align-items: flex-start; }
    .stepper { padding-bottom: 8px; }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .001ms !important;
        transition-duration: .001ms !important;
        scroll-behavior: auto !important;
    }
}

@media (max-width: 700px) {
    .table-wrap:has(> table.responsive) { overflow: visible; }
    table.responsive { min-width: 0 !important; }
    table.responsive thead { display: none; }
    table.responsive tbody,
    table.responsive tr,
    table.responsive td { display: block; width: 100%; }
    table.responsive tr {
        margin-bottom: 9px;
        padding: 11px 13px;
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        background: var(--surface);
    }
    table.responsive tr:last-child { margin-bottom: 0; }
    table.responsive tr:hover { background: var(--surface); }
    table.responsive td {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 4px 0;
        border: 0;
        text-align: right;
        overflow-wrap: anywhere;
    }
    table.responsive td::before {
        content: attr(data-label);
        flex: 0 0 auto;
        color: var(--muted);
        font-size: .64rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-align: left;
        text-transform: uppercase;
    }
    table.responsive td:first-child {
        display: block;
        margin-bottom: 4px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--line-soft);
        text-align: left;
    }
    table.responsive td:first-child::before { display: none; }
    table.responsive td[data-label=""]::before { display: none; }
    table.responsive td.cell-action { justify-content: flex-end; }
    table.responsive td small { display: block; margin-top: 3px; }
}

@media print {
    .sidebar, .topbar-actions, .app-footer, .sidebar-scrim, .form-actions, .btn { display: none !important; }
    .app { margin: 0; }
    .content { max-width: none; padding: 0; }
    .card, .detail-hero { border-color: #ccc; box-shadow: none; }
    body { background: #fff; }
}
