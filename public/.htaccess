# SIG-Banca — pasta pública
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

# O limite da aplicação é 10 MB (UPLOAD_MAX_BYTES). Ajuste também o PHP quando
# o servidor usa mod_php, para que o upload chegue à validação da aplicação.
<IfModule php_module>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rotas amigáveis: tudo o que não for arquivo/diretório cai no controlador.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
